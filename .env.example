# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
API_CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_dev
TEST_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_test

# Redis / Dramatiq
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finance-uploads
S3_REGION=us-east-1
S3_USE_SSL=false
# Set true to use local filesystem instead of MinIO
STORAGE_FILESYSTEM_FALLBACK=true
STORAGE_LOCAL_PATH=./.data/uploads

# LLM
LLM_PROVIDER=stub
LLM_MODEL=stub-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
